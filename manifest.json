{
  "manifest_version": 3,
  "name": "Subtitle Cleaner",
  "version": "0.3.0",
  "description": "Filtra en tiempo real el contenido no-dialogal de los subtítulos en Netflix y Prime Video.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content-scripts/core/cleaner.js",
        "content-scripts/core/subtitle-observer.js",
        "content-scripts/sites/netflix.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*"
      ],
      "js": [
        "content-scripts/core/cleaner.js",
        "content-scripts/core/subtitle-observer.js",
        "content-scripts/sites/prime.js"
      ],
      "run_at": "document_idle"
    }
  ]
}